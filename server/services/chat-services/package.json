{
  "name": "chat-services",
  "version": "1.0.0",
  "description": "Production-grade chat service",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": ["**/?(*.)+(spec|test).[jt]s?(x)"],
    "moduleNameMapper": {
      "^mongoose$": "<rootDir>/tests/__mocks__/mongoose.js",
      "^ioredis$": "<rootDir>/tests/__mocks__/ioredis.js",
      "^kafkajs$": "<rootDir>/tests/__mocks__/kafkajs.js",
      "^socket\\.io$": "<rootDir>/tests/__mocks__/socket.io.js"
    },
    "testPathIgnorePatterns": ["/node_modules/", "/logs/"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.4.1",
    "opossum": "^10.0.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  }
}
